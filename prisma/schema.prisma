generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Enums ----------

enum SpaceType {
  PROJECT
  PERSONAL
}

enum MemberRole {
  OWNER
  MEMBER
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum Currency {
  INR
  USD
}

enum PaymentMethod {
  CREDIT_CARD
  UPI
  CASH
  BANK
}

// ---------- Models ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  memberships        SpaceMember[]
  transactions       Transaction[] @relation("TransactionMember")
  createdTransactions Transaction[] @relation("TransactionCreator")
  settlementsFrom    Settlement[]  @relation("SettlementFrom")
  settlementsTo      Settlement[]  @relation("SettlementTo")

  @@map("users")
}

model Space {
  id           String    @id @default(cuid())
  name         String
  type         SpaceType
  baseCurrency Currency  @default(INR)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  members      SpaceMember[]
  categories   Category[]
  transactions Transaction[]
  settlements  Settlement[]
  budgets      Budget[]

  @@map("spaces")
}

model SpaceMember {
  id           String     @id @default(cuid())
  spaceId      String
  userId       String
  role         MemberRole @default(MEMBER)
  // Profit/contribution share for PROJECT spaces (e.g. 50.00). Ignored for PERSONAL.
  sharePercent Decimal    @default(50.00) @db.Decimal(5, 2)
  createdAt    DateTime   @default(now())

  space Space @relation(fields: [spaceId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

model Category {
  id      String       @id @default(cuid())
  spaceId String
  name    String
  kind    CategoryKind
  icon    String?
  color   String?

  space        Space         @relation(fields: [spaceId], references: [id])
  transactions Transaction[]
  budgets      Budget[]

  @@unique([spaceId, name, kind])
  @@map("categories")
}

model Transaction {
  id             String          @id @default(cuid())
  spaceId        String
  type           TransactionType
  // Amount as entered, in its original currency.
  amountOriginal Decimal         @db.Decimal(12, 2)
  currency       Currency
  // Rate used on the transaction date (1.0 when currency == baseCurrency).
  fxRate         Decimal         @default(1.0) @db.Decimal(12, 6)
  // amountOriginal * fxRate, in the space's base currency. All reports use this.
  amountBase     Decimal         @db.Decimal(12, 2)
  memberId       String // who paid (expense) / who received (income)
  categoryId     String
  paymentMethod  PaymentMethod
  date           DateTime        @db.Date
  note           String?         @db.VarChar(500)
  receiptPath    String?
  createdById    String
  createdAt      DateTime        @default(now())
  deletedAt      DateTime? // soft delete only — money records are never erased

  space     Space    @relation(fields: [spaceId], references: [id])
  member    User     @relation("TransactionMember", fields: [memberId], references: [id])
  category  Category @relation(fields: [categoryId], references: [id])
  createdBy User     @relation("TransactionCreator", fields: [createdById], references: [id])

  @@index([spaceId, date])
  @@index([spaceId, type, deletedAt])
  @@map("transactions")
}

model Settlement {
  id         String    @id @default(cuid())
  spaceId    String
  fromUserId String
  toUserId   String
  // Always in the space's base currency.
  amount     Decimal   @db.Decimal(12, 2)
  date       DateTime  @db.Date
  note       String?   @db.VarChar(500)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  space    Space @relation(fields: [spaceId], references: [id])
  fromUser User  @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("SettlementTo", fields: [toUserId], references: [id])

  @@index([spaceId, date])
  @@map("settlements")
}

model Budget {
  id         String  @id @default(cuid())
  spaceId    String
  // Null category = overall monthly budget for the space.
  categoryId String?
  // First day of the month this budget applies to (e.g. 2026-08-01).
  month      DateTime @db.Date
  amount     Decimal  @db.Decimal(12, 2)

  space    Space     @relation(fields: [spaceId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@unique([spaceId, categoryId, month])
  @@map("budgets")
}
