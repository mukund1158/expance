# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection (keep MySQL bound to localhost — the app connects locally)
DATABASE_URL="mysql://expance_user:CHANGE_ME@localhost:3306/expance"

# Auth.js session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# Production only (behind Nginx/HTTPS). Leave commented for local dev.
# AUTH_URL="https://expance.space"
# AUTH_TRUST_HOST=true
